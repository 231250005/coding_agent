# 通义千问（阿里云百炼）API Key —— 已添加到系统环境变量
DASHSCOPE_API_KEY=sk-xxxxx

# 模型名（如百炼控制台实际模型名不同，改这里即可）
QWEN_MODEL=qwen3.7-plus

# 单任务 LLM 调用次数上限（预算护栏，防失控烧额度）
MAX_LLM_CALLS=60

# 上下文压缩触发阈值（消息总量超过则裁剪/摘要旧历史）
MAX_CONTEXT_TOKENS=20000

# MySQL 数据库（不存在时自动创建 coding_agent 库）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# agent 工作目录（agent 只允许在此目录内读写文件、执行命令）
WORKSPACE_DIR=.
